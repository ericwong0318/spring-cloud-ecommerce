# Splunk Observability Cloud Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Your Splunk Observability Access Token (get from Splunk Cloud console)
SPLUNK_ACCESS_TOKEN=your-token-here

# Splunk Ingest Endpoint URL
SPLUNK_INGEST_URL=https://ingest.your-realm.splunkcloud.com

# Splunk Realm (e.g., sg0, us1, eu0)
SPLUNK_REALM=your-realm
