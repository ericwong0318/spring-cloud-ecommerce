# ──────────────────────────────────────────────
# Splunk Observability
# ──────────────────────────────────────────────
SPLUNK_ACCESS_TOKEN=your-splunk-access-token
SPLUNK_INGEST_URL=https://ingest.sg0.splunkcloud.com
SPLUNK_REALM=sg0

# ──────────────────────────────────────────────
# Databases (PostgreSQL - one per service)
# ──────────────────────────────────────────────
POSTGRES_PRODUCT_PASSWORD=localdev
POSTGRES_CATEGORY_PASSWORD=localdev
POSTGRES_ORDER_PASSWORD=localdev
POSTGRES_INVENTORY_PASSWORD=localdev
POSTGRES_PAYMENT_PASSWORD=localdev
POSTGRES_NOTIFICATION_PASSWORD=localdev

# ──────────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ──────────────────────────────────────────────
# MongoDB (Product Service)
# ──────────────────────────────────────────────
MONGO_INITDB_DATABASE=product_db

# ──────────────────────────────────────────────
# Kafka (if used)
# ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ──────────────────────────────────────────────
# Mail (Notification Service)
# ──────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=